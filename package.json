{
  "name": "gjlm-books",
  "version": "1.0.0",
  "description": "Catálogo Interativo 2.0 de livros com React Native, Expo e Open Library",
  "engines": {
    "node": ">=24.12.0"
  },
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
